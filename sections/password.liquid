{% comment %}
  Password page – minimalist storefront password
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section class="password-page section-spacing page-section">
  <div class="page-width password-page__inner">
    <h1 class="page-title page-title--large">{{ 'password.title' | t }}</h1>
    {% if shop.password_message != blank %}
      <p class="page-text">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}
        {{ form.errors | default_errors }}
      {% endif %}
      <div class="form-group">
        <label for="password-input">{{ 'password.password' | t }}</label>
        <input type="password" name="password" id="password-input" placeholder="{{ 'password.password' | t }}" required autofocus>
      </div>
      <button type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</section>

<style>
.password-page {
  background: #fff;
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.password-page__inner {
  max-width: 24rem;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

.password-form {
  margin-top: 1.5rem;
  text-align: left;
}

.password-form .form-group {
  margin-bottom: 1rem;
}

.password-form input {
  width: 100%;
}

.password-form button {
  width: 100%;
  margin-top: 0.5rem;
}
</style>

{% schema %}
{
  "name": "t:general.password",
  "tag": "section",
  "class": "password-section",
  "settings": []
}
{% endschema %}
