
{% assign collection = section.settings.collection %}
{% assign selected_collection = collections[collection] %}
<div class="page-width"> 
{% for product in selected_collection.products %}
   {{ product.featured_image | image_url:'master' | img_tag }}
   {{ product.price | money }}
   {{ product.compare_at_price | money }}
{% endfor %}
</div>

{% schema %}
 {
  "name":"collection picker",
   "settings":[
      {
        "type":"collection",
         "id":"collection",
         "label":"select collection"
      }
   ],
   "presets":[
    {
     "name":"collection picker gm"
    }
   ]
 }
{% endschema %}