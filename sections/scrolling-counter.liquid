<section class="scrolling-text" aria-hidden="true">
  <div class="scrolling-text__track">
    <span class="scrolling-text__content">{{ section.settings.scroll_text }}</span>
    <span class="scrolling-text__content" aria-hidden="true">{{ section.settings.scroll_text }}</span>
  </div>
</section>

<style>
.scrolling-text {
  background: #3d4a40;
  padding: 1rem 0;
  overflow: hidden;
}

.scrolling-text__track {
  display: flex;
  gap: 3rem;
  animation: scrollText 35s linear infinite;
  white-space: nowrap;
}

.scrolling-text__content {
  font-size: 0.8125rem;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.9);
}

@keyframes scrollText {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>


{% schema %}
{
  "name": "Scrolling Text",
  "settings": [
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scrolling Text",
      "default": "Together we’ve planted 115,206,885 trees."
    }
  ],
  "presets": [
    {
      "name": "Scrolling Text",
      "category": "Home Page"
    }
  ]
}
{% endschema %}
