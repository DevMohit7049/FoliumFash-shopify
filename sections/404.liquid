{% comment %}
  404 page – minimalist not found
  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<section class="error-page section-spacing page-section">
  <div class="page-width error-page__inner">
    <h1 class="page-title page-title--large">{{ '404.title' | t }}</h1>
    <p class="page-text">{{ '404.not_found' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="page-link btn-primary">{{ '404.back_to_shopping' | t }}</a>
  </div>
</section>

<style>
.error-page {
  background: #fff;
  text-align: center;
}

.error-page__inner {
  max-width: 28rem;
  margin-left: auto;
  margin-right: auto;
}

.error-page .btn-primary {
  margin-top: 1.5rem;
  color: #fff;
}

.error-page .btn-primary:hover {
  opacity: 0.9;
}
</style>

{% schema %}
{
  "name": "t:general.404",
  "tag": "section",
  "class": "error-section",
  "settings": []
}
{% endschema %}
