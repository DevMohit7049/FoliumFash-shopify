<section class="popular-categories">
  <div class="popular-categories__inner">
    <div class="category-header">
      <h2 class="category-header__title">Most Popular Categories</h2>
      <div class="scroll-arrows">
        <button type="button" class="scroll-btn left" aria-label="Scroll left">‹</button>
        <button type="button" class="scroll-btn right" aria-label="Scroll right">›</button>
      </div>
    </div>
    <div class="category-scroll" id="category-scroll">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="category-card">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
              width="300"
              height="300"
              class="category-card__img"
            >
          {% endif %}
          <p class="category-card__title">{{ block.settings.title }}</p>
          <span class="category-card__arrow" aria-hidden="true">→</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{{ 'popular-categories.css' | asset_url | stylesheet_tag }}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const scrollContainer = document.getElementById('category-scroll');
  const leftBtn = document.querySelector('.scroll-btn.left');
  const rightBtn = document.querySelector('.scroll-btn.right');

  leftBtn.addEventListener('click', () => {
    scrollContainer.scrollBy({ left: -300, behavior: 'smooth' });
  });

  rightBtn.addEventListener('click', () => {
    scrollContainer.scrollBy({ left: 300, behavior: 'smooth' });
  });
});
</script>

{% schema %}
 {
   "name": "popular categories",
   "settings": [],
   "blocks": [
     {
      "type": "category",
       "name":"Category Card",
       "settings": [
        {
        "type": "image_picker",
        "id": "image",
        "label": "Category Image"
        },
        {
         "type": "text",
         "id": "title",
         "label": "Category Title"
        },
        {
         "type": "url",
         "id": "link",
         "label": "Category Link"
        }
       ]
     }
   ],
   "presets": [{"name": "Popular Categories","category": "Home Page"}]
 }
{% endschema %}
