{% comment %}
  Collection page – minimalist product grid
  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section class="collection-page section-spacing page-section">
  <div class="page-width">
    <header class="collection-header">
      <h1 class="page-title page-title--large">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-description page-text">{{ collection.description }}</div>
      {% endif %}
    </header>

    {% paginate collection.products by 24 %}
      {% if collection.products.size > 0 %}
        <div class="collection-grid">
          {% for product in collection.products %}
            <article class="collection-card">
              <a href="{{ product.url }}" class="collection-card__link">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | default: product.title }}"
                    width="300"
                    height="300"
                    loading="lazy"
                    class="collection-card__img"
                  >
                {% else %}
                  <div class="collection-card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
                {% endif %}
                <div class="collection-card__info">
                  <h2 class="collection-card__title">{{ product.title }}</h2>
                  <p class="collection-card__price">{{ product.price | money }}</p>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="pagination-wrapper">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% else %}
        <p class="no-products page-text">No products in this collection.</p>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<style>
.collection-page {
  background: #fff;
}

.collection-header {
  margin-bottom: 2rem;
}

.collection-description {
  max-width: 42rem;
  margin-top: 0.5rem;
}

.collection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.5rem;
}

.collection-card__link {
  display: block;
  color: inherit;
}

.collection-card__link:hover {
  opacity: 0.9;
}

.collection-card__img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 0.75rem;
}

.collection-card__placeholder {
  width: 100%;
  aspect-ratio: 1;
  background: #f5f5f5;
  border-radius: 8px;
  margin-bottom: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.collection-card__placeholder svg {
  width: 50%;
  opacity: 0.4;
}

.collection-card__title {
  font-size: 0.9375rem;
  font-weight: 500;
  color: #1a1a1a;
  margin: 0 0 0.25rem 0;
}

.collection-card__price {
  font-size: 0.875rem;
  color: #6b6b6b;
  margin: 0;
}

.no-products {
  text-align: center;
  padding: 3rem 0;
}

.pagination-wrapper {
  margin-top: 3rem;
}
</style>

{% schema %}
{
  "name": "t:general.collection",
  "tag": "section",
  "class": "collection-section",
  "settings": []
}
{% endschema %}
