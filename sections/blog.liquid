{% comment %}
  Blog page – minimalist article list
  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<section class="blog-page section-spacing page-section">
  <div class="page-width">
    <h1 class="page-title page-title--large">{{ blog.title }}</h1>

    {% paginate blog.articles by 10 %}
      <div class="blog-articles">
        {% for article in blog.articles %}
          <article class="blog-article">
            <a href="{{ article.url }}" class="blog-article__link">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | default: article.title }}"
                  width="400"
                  height="240"
                  loading="lazy"
                  class="blog-article__img"
                >
              {% endif %}
              <div class="blog-article__content">
                <h2 class="blog-article__title">{{ article.title }}</h2>
                {% assign date = article.published_at | time_tag: format: 'date' %}
                <p class="blog-article__meta">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
                {% if article.excerpt != blank %}
                  <p class="blog-article__excerpt page-text">{{ article.excerpt | strip_html | truncate: 120 }}</p>
                {% else %}
                  <p class="blog-article__excerpt page-text">{{ article.content | strip_html | truncate: 120 }}</p>
                {% endif %}
              </div>
            </a>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="pagination-wrapper">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<style>
.blog-page {
  background: #fff;
}

.blog-articles {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.blog-article__link {
  display: block;
  color: inherit;
}

.blog-article__link:hover {
  opacity: 0.9;
}

.blog-article__img {
  width: 100%;
  max-height: 280px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 0.75rem;
}

.blog-article__content {
  margin-top: 0.5rem;
}

.blog-article__title {
  font-size: 1.25rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: #1a1a1a;
  margin: 0 0 0.375rem 0;
}

.blog-article__meta {
  font-size: 0.875rem;
  color: #6b6b6b;
  margin: 0 0 0.5rem 0;
}

.blog-article__excerpt {
  font-size: 0.9375rem;
  margin: 0;
}

.pagination-wrapper {
  margin-top: 3rem;
}
</style>

{% schema %}
{
  "name": "t:general.blog",
  "tag": "section",
  "class": "blog-section",
  "settings": []
}
{% endschema %}
