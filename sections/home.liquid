{% comment %}
  Hero Banner – minimalist, centered content over image.
  Fully editable in Theme Editor.
{% endcomment %}

{{ 'home.css' | asset_url | stylesheet_tag }}

<section class="hero-banner home" style="--hero-text: {{ section.settings.text_color }}; --hero-btn-bg: {{ section.settings.button_bg }}; --hero-btn-text: {{ section.settings.button_text_color }};">
  {% if section.settings.hero_image %}
    <div class="hero-banner__image">
      <img
        src="{{ section.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ section.settings.hero_title | escape }}"
        class="hero-banner__img"
        loading="eager"
        width="2000"
        height=""
      >
    </div>
    <div class="hero-banner__overlay" aria-hidden="true"></div>
  {% endif %}

  <div class="hero-banner__content container" style="color: {{ section.settings.text_color }};">
    {% if section.settings.hero_subtitle != blank %}
      <p class="hero-banner__subtitle">{{ section.settings.hero_subtitle }}</p>
    {% endif %}
    {% if section.settings.hero_title != blank %}
      <h1 class="hero-banner__title">{{ section.settings.hero_title }}</h1>
    {% endif %}
    {% if section.settings.hero_text != blank %}
      <p class="hero-banner__text">{{ section.settings.hero_text }}</p>
    {% endif %}
    {% if section.settings.hero_button_link != blank and section.settings.hero_button_text != blank %}
      <a href="{{ section.settings.hero_button_link }}" class="hero-banner__btn" style="background: {{ section.settings.button_bg }}; color: {{ section.settings.button_text_color }}; border-color: {{ section.settings.button_text_color }};">
        {{ section.settings.hero_button_text }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image",
      "info": "Recommended size: 2000×800 px"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Title",
      "default": "Heal from Within"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Subtitle",
      "default": "Welcome to Amiy Naturals"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Description Text",
      "default": "Discover our doctor-formulated oral drops that bring wellness and glow from inside out."
    },
    {
      "type": "text",
      "id": "hero_button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
